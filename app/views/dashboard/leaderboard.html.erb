<% if @game.zip_file.attached? %>
<p>
  <%= link_to 'Download all photos', url_for(@game.zip_file) %>
</p>
<% end %>
<p><ol>
  <% @total_by_team.sort_by {|_team, score| -score}.each do |team, score| %>
  <li><%= team.try(:name) %>: <%= score %> points (<%= @missions_by_team[team].length %> missions)!<ul>
    <% @missions_by_team[team].sort_by(&:codenum).each do |mission| %>
      <li><%= mission.codenum %>. <%= mission.name %></li>
    <% end %>
  </ul></li>
  <% end %>
</ol></p>

<p><small>Run your own hunt at <a href="https://photoscavenger.com">photoscavenger.com</a></small></p>
